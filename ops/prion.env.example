CF_ACCESS_TEAM_DOMAIN=https://YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=YOUR_ACCESS_APPLICATION_AUDIENCE
CF_ACCESS_ORIGIN=https://wiki.example.org
MEDIA_ORIGIN=https://media.example.org
DATA_DIR=/var/lib/prion
BIND_ADDRESS=127.0.0.1
PORT=3000
NODE_OPTIONS=--max-old-space-size=256
# Optional AI CSS assistant. Add a fresh key only to /etc/prion.env on the server.
# OPENAI_API_KEY=your-new-server-only-key
AI_DAILY_REQUEST_LIMIT=100

# MP4/WebM/GLB: 0 means no fixed per-file cap on direct media.
MEDIA_LARGE_MAX_MIB=0
MEDIA_MIN_FREE_MIB=256
MEDIA_UPLOAD_TIMEOUT_SECONDS=1800
# Enable after installing the separate Codex worker:
# CODEX_SOCKET=/run/prion-codex/worker.sock
