CF_ACCESS_ORIGIN=https://igem2026.gpupods.cloud
MEDIA_ORIGIN=https://media-igem2026.gpupods.cloud
DATA_DIR=/var/lib/prion
BIND_ADDRESS=127.0.0.1
PORT=3000
NODE_OPTIONS=--max-old-space-size=256
